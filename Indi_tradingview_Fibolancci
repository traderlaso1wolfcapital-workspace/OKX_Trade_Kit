//=============================
// OB / FVG DETECTION
// Basic logic:
// - Bullish OB: last bearish candle before bullish displacement.
// - Bearish OB: last bullish candle before bearish displacement.
// - Bullish FVG: low > high[2].
// - Bearish FVG: high < low[2].
//=============================
f_findBullOB(_lookback) =>
    float _top = na
    float _bot = na
    int   _bar = na
    for i = 1 to _lookback
        if close[i] < open[i]
            _top := high[i]
            _bot := low[i]
            _bar := bar_index - i
            break
    [_top, _bot, _bar]

f_findBearOB(_lookback) =>
    float _top = na
    float _bot = na
    int   _bar = na
    for i = 1 to _lookback
        if close[i] > open[i]
            _top := high[i]
            _bot := low[i]
            _bar := bar_index - i
            break
    [_top, _bot, _bar]

var float bullObTop = na
var float bullObBot = na
var int   bullObBar = na
var float bearObTop = na
var float bearObBot = na
var int   bearObBar = na

var float bullFvgTop = na
var float bullFvgBot = na
var int   bullFvgBar = na
var float bearFvgTop = na
var float bearFvgBot = na
var int   bearFvgBar = na

var box bullObBox = na
var box bearObBox = na
var box bullFvgBox = na
var box bearFvgBox = na

bullDisplacement = close > open and close > ta.highest(high, obBreakLen)[1]
bearDisplacement = close < open and close < ta.lowest(low, obBreakLen)[1]

if bullDisplacement
    [obT, obB, obBar] = f_findBullOB(obLookback)
    if not na(obT) and not na(obB)
        bullObTop := obT
        bullObBot := obB
        bullObBar := obBar

        if showEntryZones
            if not na(bullObBox)
                box.delete(bullObBox)
            bullObBox := box.new(
                    left=bullObBar, top=bullObTop, right=bar_index + extendBars, bottom=bullObBot,
                    xloc=xloc.bar_index,
                    bgcolor=color.new(color.lime, 88),
                    border_color=color.new(color.lime, 20))

if bearDisplacement
    [obT, obB, obBar] = f_findBearOB(obLookback)
    if not na(obT) and not na(obB)
        bearObTop := obT
        bearObBot := obB
        bearObBar := obBar

        if showEntryZones
            if not na(bearObBox)
                box.delete(bearObBox)
            bearObBox := box.new(
                    left=bearObBar, top=bearObTop, right=bar_index + extendBars, bottom=bearObBot,
                    xloc=xloc.bar_index,
                    bgcolor=color.new(color.red, 88),
                    border_color=color.new(color.red, 20))

// FVG zones
if low > high[2]
    bullFvgTop := low
    bullFvgBot := high[2]
    bullFvgBar := bar_index - 1

    if showEntryZones
        if not na(bullFvgBox)
            box.delete(bullFvgBox)
        bullFvgBox := box.new(
                left=bar_index - 2, top=bullFvgTop, right=bar_index + extendBars, bottom=bullFvgBot,
                xloc=xloc.bar_index,
                bgcolor=color.new(color.green, 90),
                border_color=color.new(color.green, 35))

if high < low[2]
    bearFvgTop := low[2]
    bearFvgBot := high
    bearFvgBar := bar_index - 1

    if showEntryZones
        if not na(bearFvgBox)
            box.delete(bearFvgBox)
        bearFvgBox := box.new(
                left=bar_index - 2, top=bearFvgTop, right=bar_index + extendBars, bottom=bearFvgBot,
                xloc=xloc.bar_index,
                bgcolor=color.new(color.red, 90),
                border_color=color.new(color.red, 35))

validBullOB  = not na(bullObTop)  and not na(bullObBot)  and not na(bullObBar)  and (bar_index - bullObBar  <= obMaxAge)
validBearOB  = not na(bearObTop)  and not na(bearObBot)  and not na(bearObBar)  and (bar_index - bearObBar  <= obMaxAge)
validBullFVG = not na(bullFvgTop) and not na(bullFvgBot) and not na(bullFvgBar) and (bar_index - bullFvgBar <= fvgMaxAge)
validBearFVG = not na(bearFvgTop) and not na(bearFvgBot) and not na(bearFvgBar) and (bar_index - bearFvgBar <= fvgMaxAge)

// Pick one entry price.
// Priority when multiple sources are enabled: OB -> FVG -> Fib.
// Long uses top of bullish OB/FVG as first-touch entry.
// Short uses bottom of bearish OB/FVG as first-touch entry.
f_pickEntryPrice(_dir, _fibPrice) =>
    bool _wantFib = str.contains(entryMode, "Fib")
    bool _wantOB  = str.contains(entryMode, "OB")
    bool _wantFVG = str.contains(entryMode, "FVG")

    float _obEntry = na
    float _fvgEntry = na

    if _dir == 1
        _obEntry  := validBullOB  ? bullObTop  : na
        _fvgEntry := validBullFVG ? bullFvgTop : na
    else
        _obEntry  := validBearOB  ? bearObBot  : na
        _fvgEntry := validBearFVG ? bearFvgBot : na

    float _entry = na

    if _wantOB and not na(_obEntry)
        _entry := _obEntry
    else if _wantFVG and not na(_fvgEntry)
        _entry := _fvgEntry
    else if _wantFib
        _entry := _fibPrice

    _entry

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

