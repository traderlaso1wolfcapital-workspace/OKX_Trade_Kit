// ~~ Main {
if dir != dir[1]
    x   = dir > 0 ? plL : phL
    y   = dir > 0 ? pl  : ph
    loc = dir > 0 ? label.style_label_up : label.style_label_down
    col = dir > 0 ? highS : lowS
    txt = dir > 0 and pl < prev ? 'LL' : dir > 0 and pl > prev ? 'HL' : dir < 0 and ph < prev ? 'LH' : dir < 0 and ph > prev ? 'HH' : ''

    //=============================
    // Build sequence text (LL1, LL2... / HL2, HL3...)
    //=============================
    seqTxt = txt

    if txt != ""
        // ----- Reset / start conditions -----

        if txt == "HL"
            if cycleMode == 1
                cycleMode := 0
                llCount := 0
                lhCountDisp := 0

            if cycleMode != 2
                cycleMode := 2
                hlCount := 1                
                hhCountDisp := 0
                seqTxt := showSwingSequence ? "HL1" : "HL"                
            else
                hlCount += 1                     
                seqTxt := showSwingSequence ? ("HL" + str.tostring(hlCount)) : "HL"

        else if txt == "HH"
            if cycleMode == 2
                hhCountDisp += 1
                seqTxt := showSwingSequence ? ("HH" + str.tostring(hhCountDisp)) : "HH"
            else
                seqTxt := "HH"

        else if txt == "LH"
            if cycleMode == 2
                cycleMode := 0
                hlCount := 0
                hhCountDisp := 0

            if cycleMode == 1
                lhCountDisp += 1
                seqTxt := showSwingSequence ? ("LH" + str.tostring(lhCountDisp)) : "LH"
            else
                seqTxt := "LH"

        else if txt == "LL"
            if cycleMode != 1
                cycleMode := 1
                llCount := 0                      // ✅ reset về 0
                lhCountDisp := 0
            else
                llCount += 1                      // ✅ lần 2 bắt đầu tăng: 1,2,3...

            hlCount := 0
            hhCountDisp := 0

            seqTxt := showSwingSequence ? (llCount == 0 ? "LL" : ("LL" + str.tostring(llCount))) : "LL"

    // Draw label
    if showSwingStructureLabels and txt != ""
        label.new(x, y, text=seqTxt, style=loc, color=color.new(col, 20), textcolor=color.white)

        //=========================================================
        // STRUCTURE-BASED SIGNAL ENGINE (theo HH/HL/LH/LL sequence)
        //=========================================================
        // x = pivot bar, y = pivot price, txt = HH/HL/LH/LL (đã có sẵn ở trên)

        if txt == "LL"
            // ----- Long cycle seed -----
            if na(longBaseLL)
                longBaseLL := y
                hhCountLong := 0
                hlCountLong2 := 0
                longTrendReady := false
                longLastHH := na
                longPrevHL := na
                longCurrHL := na

            // ----- Short cycle continuation: LL1, LL2, LL3... -----
            llCountShort2 += 1
            shortLastLL := y

            if llCountShort2 >= 2 and lhCountShort >= 1 and hhCountShortSeed >= 1 and not na(shortCurrLH)
                shortTrendReady := true

                // ===== CREATE SHORT SETUP (inline) =====
                // anchor = LH1/LH2..., target = LL2/LL3...
                if showFibSignals and emaBear and shortCurrLH > shortLastLL
                    leg = shortCurrLH - shortLastLL
                    fibEntryPrice = shortLastLL + leg * fibEntryRatio
                    pickedEntry   = f_pickEntryPrice(-1, fibEntryPrice)

                    if not na(pickedEntry)
                        setupActive   := true
                        entered       := false
                        setupDir      := -1

                        setupEntry := pickedEntry
                        setupTP    := shortLastLL + leg * tpFibRatio
                        setupSL    := shortLastLL + leg * slFibRatio
                        setupEntry2 := shortLastLL + leg * fibEntry2Ratio
                        setupTP1    := shortLastLL + leg * tp1FibRatio

                        setupStartBar := shortCurrLHBar
                        newSetup      := true

                        if not na(lnEntry)
                            line.delete(lnEntry)
                        if not na(lnTP)
                            line.delete(lnTP)
                        if not na(lnSL)
                            line.delete(lnSL)

                        x1 = setupStartBar
                        x2 = setupStartBar + extendBars

                        lnEntry := line.new(x1, setupEntry, x2, setupEntry, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.red, 0), width=1, style=line.style_dashed)
                        lnTP    := line.new(x1, setupTP,    x2, setupTP,    xloc=xloc.bar_index, extend=extend.none, color=color.new(color.lime, 0), width=1, style=line.style_dashed)
                        lnSL    := line.new(x1, setupSL,    x2, setupSL,    xloc=xloc.bar_index, extend=extend.none, color=color.new(color.red, 0), width=1, style=line.style_dashed)

        else if txt == "HH"
            // ----- Short cycle seed -----
            if not na(shortBaseHL)
                hhCountShortSeed += 1

            // ----- Long cycle continuation: HH1, HH2, HH3... -----
            hhCountLong += 1
            longLastHH := y

            // ✅ NEW: CREATE LONG SETUP ON HH (Fib from HL[n] -> HH[n])
            // HL anchor = HL gần nhất đã xác nhận (longCurrHL). Nếu chưa có HL thì không tạo.
            if showFibSignals and emaBull and not na(longCurrHL) and longLastHH > longCurrHL
                leg = longLastHH - longCurrHL   // HL -> HH
                fibEntryPrice = longLastHH - leg * fibEntryRatio
                pickedEntry   = f_pickEntryPrice(1, fibEntryPrice)

                if not na(pickedEntry)
                    setupActive   := true
                    entered       := false
                    setupDir      := 1

                    setupEntry := pickedEntry
                    setupTP    := longLastHH - leg * tpFibRatio
                    setupSL    := longLastHH - leg * slFibRatio
                    setupEntry2 := longLastHH - leg * fibEntry2Ratio
                    setupTP1    := longLastHH - leg * tp1FibRatio

                    setupStartBar := longCurrHLBar   // bắt đầu vẽ từ HL
                    newSetup      := true

                    if not na(lnEntry)
                        line.delete(lnEntry)
                    if not na(lnTP)
                        line.delete(lnTP)
                    if not na(lnSL)
                        line.delete(lnSL)

                    x1 = setupStartBar
                    x2 = setupStartBar + extendBars

                    lnEntry := line.new(x1, setupEntry, x2, setupEntry, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.lime, 0), width=1, style=line.style_dashed)
                    lnTP    := line.new(x1, setupTP,    x2, setupTP,    xloc=xloc.bar_index, extend=extend.none, color=color.new(color.lime, 0), width=1, style=line.style_dashed)
                    lnSL    := line.new(x1, setupSL,    x2, setupSL,    xloc=xloc.bar_index, extend=extend.none, color=color.new(color.red, 0), width=1, style=line.style_dashed)

        else if txt == "HL"
            // ----- Short cycle seed -----
            if na(shortBaseHL)
                llCountShort2 := 0
                lhCountShort  := 0
                hhCountShortSeed := 0
                shortPrevLH   := na
                shortPrevLHBar:= na
                shortCurrLH   := na
                shortCurrLHBar:= na
                shortLastLL   := na
                shortBaseHL   := y

            // ----- Long cycle continuation: HL1, HL2, HL3... -----
            hlCountLong2 += 1
            longPrevHL    := longCurrHL
            longPrevHLBar := longCurrHLBar
            longCurrHL    := y
            longCurrHLBar := x
        

            llCountShort2 := 0
            lhCountShort  := 0
            shortPrevLH   := na
            shortPrevLHBar:= na
            shortCurrLH   := na
            shortCurrLHBar:= na
            shortLastLL   := na
            shortBaseHL   := y

        else if txt == "LH"
            lhCountShort += 1
            shortPrevLH    := shortCurrLH
            shortPrevLHBar := shortCurrLHBar
            shortCurrLH    := y
            shortCurrLHBar := x

            hhCountLong    := 0
            hlCountLong2   := 0
            longPrevHL     := na
            longPrevHLBar  := na
            longCurrHL     := na
            longCurrHLBar  := na
            longLastHH     := na
            longBaseLL     := na
            longTrendReady := false

    prev := dir > 0 ? ph[1] : pl[1]

    barsback = b - x
    p   := y * volume[barsback]
    vol := volume[barsback]
    vap = p / vol

    vwap.poly.delete()
    polyline.new(vwap.points, false, false, line_color = dir < 0 ? R : S, line_width = xx)
    vwap.points.clear()

    for i = barsback to 0 by 1
        apt_i = aptSeries[i]
        alpha = alphaFromAPT(apt_i)

        pxv   = hlc3[i] * volume[i]
        v_i   = volume[i]

        p     := (1.0 - alpha) * p + alpha * pxv
        vol   := (1.0 - alpha) * vol + alpha * v_i
        vappe = vol > 0 ? p / vol : na

        vwap.points.push(chart.point.from_index(b - i, vappe))

    vwap.poly := polyline.new(vwap.points, false, false, line_color = dir < 0 ? R : S, line_width = xx)

else
    apt_0 = aptSeries
    alpha = alphaFromAPT(apt_0)

    pxv = hlc3 * volume
    v0  = volume

    p   := (1.0 - alpha) * p + alpha * pxv
    vol := (1.0 - alpha) * vol + alpha * v0
    vap = vol > 0 ? p / vol : na

    vwap.poly.delete()
    vwap.points.push(chart.point.from_index(b, vap))
    vwap.poly := polyline.new(vwap.points, false, false, line_color = dir < 0 ? R : S, line_width = xx)

//================ UI DRAW (FILLED STYLE - KEEP ALL setups) ================
uiFilled = input.bool(true, "UI Filled Style", group="UI Style")
uiPadBars = input.int(30, "UI Right pad (bars)", minval=1, maxval=500, group="UI Style")
fillTPAlpha = input.int(85, "TP Fill Alpha", minval=0, maxval=100, group="UI Style")
fillSLAlpha = input.int(85, "SL Fill Alpha", minval=0, maxval=100, group="UI Style")
fillEntryAlpha = input.int(20, "Entry Fill Alpha", minval=0, maxval=100, group="UI Style")
showVerticalGuide = input.bool(true, "Show vertical setup guide", group="UI Style")
showDashedLevels  = input.bool(true, "Show dashed TP/SL/Entry lines", group="UI Style")

if showUI and newSetup and not na(setupEntry) and not na(setupTP) and not na(setupSL) and not na(setupStartBar)
    newSetup := false

    //========================
    // Colors
    //========================
    cLong     = color.new(#069e7d, 0)
    cShort    = color.new(#e42f2f, 0)

    cTPTag    = color.new(color.teal,   0)
    cSLTag    = color.new(#f23744, 0)
    cEntryTag = setupDir == 1 ? cLong : cShort
    cTPFill = color.new(color.rgb(235, 222, 222), fillTPAlpha)
    cSLFill = color.new(color.rgb(252, 62, 62),  fillSLAlpha)
    cEntryFill= color.new(color.orange, fillEntryAlpha)

    cDash     = color.new(color.white, 65)

    //========================
    // Time anchors (x)
    //========================
    x1 = setupStartBar
    x2 = bar_index + uiPadBars

    x2 := math.max(x2, x1 + 1)

    //========================
    // Price anchors (y)
    //========================
    atrNow = ta.atr(14)
    z = atrNow * zoneATRmult

    entryTop = setupEntry + z
    entryBot = setupEntry - z

    isLong = setupDir == 1

    tpTop = math.max(setupTP, setupEntry)
    tpBot = math.min(setupTP, setupEntry)

    slTop = math.max(setupSL, setupEntry)
    slBot = math.min(setupSL, setupEntry)

    //========================
    // 1) FILLED BOXES
    //========================

    // TP fill zone: entry -> TP
    box.new(
            left = x1, top = tpTop, right = x2, bottom = tpBot,
            bgcolor = cTPFill,
            border_color = color.new(color.white, 100))

    // SL fill zone: entry -> SL
    box.new(
            left = x1, top = slTop, right = x2, bottom = slBot,
            bgcolor = cSLFill,
            border_color = color.new(color.white, 100))

    // Entry zone strip (đè lên giữa)
    box.new(
            left = x1, top = entryTop, right = x2, bottom = entryBot,
            bgcolor = cEntryFill,
            border_color = color.new(color.orange, 0))

    //========================
    // 2) DASHED LINES (vẽ sau box)
    //========================
    if showDashedLevels
        line.new(x1, setupTP,    x2, setupTP,    color=cDash, width=1, style=line.style_dashed)
        line.new(x1, setupSL,    x2, setupSL,    color=cDash, width=1, style=line.style_dashed)
        line.new(x1, setupEntry, x2, setupEntry, color=color.new(color.yellow, 35), width=1, style=line.style_dashed)
        line.new(x1, setupTP1,    x2, setupTP1,    color=cDash, width=1, style=line.style_dashed)
        line.new(x1, setupEntry2, x2, setupEntry2, color=color.new(color.orange, 35), width=1, style=line.style_dashed)

    if showVerticalGuide
        yTop = math.max(setupTP, setupSL)
        yBot = math.min(setupTP, setupSL)
        line.new(x1, yTop, x1, yBot, color=cDash, width=1, style=line.style_dashed)

    //========================
    // 3) LABELS (vẽ cuối)
    //========================

    dirTxt = isLong ? "Long" : "Short"
    entryStyle = isLong ? label.style_label_up : label.style_label_down
    tpStyle = isLong ? label.style_label_down : label.style_label_up

    // Không vẽ tag TP/SL nữa. Chỉ giữ 1 tag hướng lệnh.
    label.new(x2, setupEntry, dirTxt,
        style = entryStyle,
        color = cEntryTag,
        textcolor = color.white)

   // (xóa hẳn Side tag bên trái)
//=============================================================================

// 3) Entry trigger when price touches the entry level (after setup created)
longEntryTouch  = setupActive and not entered and setupDir == 1 and emaBull and low <= setupEntry
shortEntryTouch = setupActive and not entered and setupDir == -1 and emaBear and high >= setupEntry

// Optional alert conditions
alertcondition(longEntryTouch,  "Fib Long Entry",  "Fib 0.618 LONG entry touched")
alertcondition(shortEntryTouch, "Fib Short Entry", "Fib 0.618 SHORT entry touched")

//=============================
// ALERTS (Full like CRT)
//=============================
groupAL = "Alerts"

buyAlertEnabled  = input.bool(true,  "Long Entry",      inline="A1", group=groupAL)
sellAlertEnabled = input.bool(true,  "Short Entry",     inline="A1", group=groupAL)

entry2AlertEnabled = input.bool(true, "Entry2 (2/3SL)", inline="A2", group=groupAL)
tp1AlertEnabled    = input.bool(true, "TP 2/3",         inline="A2", group=groupAL)

tpAlertEnabled   = input.bool(true,  "Full TP",         inline="A3", group=groupAL)
slAlertEnabled   = input.bool(true,  "Stop Loss",       inline="A3", group=groupAL)

useWebhookAlert  = input.bool(true, "Send Webhook JSON (alert())", group=groupAL)
testAlert        = input.bool(false,"[TEST] Send 1 alert now", group=groupAL)

// Helpers for webhook
fmt(v) => str.tostring(v, format.mintick)

// event: "ENTRY" | "ENTRY2" | "TP1" | "TP" | "SL"
buildPayload(event, side, entry1, entry2, stopLoss, tp1, takeProfit, tradeId) =>
   (
       '{"event":"' + event +
       '","symbol":"' + syminfo.ticker +
       '","side":"' + side +
       '","entry1":"' + fmt(entry1) +
       '","entry2":"' + fmt(entry2) +
       '","stopLoss":"' + fmt(stopLoss) +
       '","tp1":"' + fmt(tp1) +
       '","takeProfit":"' + fmt(takeProfit) +
       '","tf":"' + timeframe.period +
       '","tradeId":"' + str.tostring(tradeId) + '"}'
   )

//=============================
// BACKTESTING DASHBOARD (TLS1)
//=============================
groupBT = "Backtesting Dashboard"
btEnabled   = input.bool(true, "Enabled", group=groupBT)
countOnlyEntry2Hit = input.bool(false, "Chỉ tính winrate các lệnh chạm Entry2", group=groupBT)
btPos       = input.string("Top Center", "Position", options=["Top Right","Top Center","Right Center"], group=groupBT)
btFillBg    = input.bool(true, "Fill Background", group=groupBT)
btOnly1Trade= input.bool(false, "Chỉ giữ 1 lệnh đang chạy)", group=groupBT)
btConservative = input.bool(false, "Nếu cùng nến chạm TP & SL -> ưu tiên SL", group=groupBT)

// ---- Stats ----
var int   btEntries   = 0    // số lệnh vào
var int   btClosed    = 0    // số lệnh đã đóng (TP/SL)
var int   btWins      = 0
var int   btLosses    = 0
var float btSumPnL    = 0.0
var float btTotalPnL  = 0.0

// ---- Trade state ----
var bool  btInTrade = false
var bool btEntry2Hit = false
var int   btSide = 0          // +1 long, -1 short
var float btEntry = na
var float btTP = na
var float btSL = na
var int btSetupDir = 0
var float btEntry2 = na

// (optional) lock setup snapshot when entering
canTakeNewSetup = not btOnly1Trade or (btOnly1Trade and not btInTrade)

// ---- Enter trade (touch entry) ----
longEnter  = btEnabled and canTakeNewSetup and setupActive and setupDir == 1 and emaBull and low <= setupEntry
shortEnter = btEnabled and canTakeNewSetup and setupActive and setupDir == -1 and emaBear and high >= setupEntry

if longEnter
    btInTrade := true
    btSide := 1
    btEntry := setupEntry
    btTP := setupTP
    btSL := setupSL
    entered := true
    btSetupDir := setupDir
    btEntries += 1
    btEntry2Hit := false
    btEntry2 := setupEntry2

    setupActive := false

if shortEnter
    btInTrade := true
    btSide := -1
    btEntry := setupEntry
    btTP := setupTP
    btSL := setupSL
    entered := true
    btSetupDir := setupDir
    btEntries += 1
    btEntry2Hit := false
    btEntry2 := setupEntry2

    setupActive := false

if btEnabled and btInTrade and not btEntry2Hit and not na(btEntry2)
    if btSide == 1 and low <= btEntry2
        btEntry2Hit := true
    if btSide == -1 and high >= btEntry2
        btEntry2Hit := true

// ---- Exit trade ----
if btEnabled and btInTrade
    bool hitTP = false
    bool hitSL = false

    if btSide == 1
        hitTP := high >= btTP
        hitSL := low  <= btSL
    else
        hitTP := low  <= btTP
        hitSL := high >= btSL

    // Resolve same-bar TP/SL conflict
    exitBySL = btConservative ? (hitSL) : (hitTP ? false : hitSL)
    exitByTP = btConservative ? (hitTP and not hitSL) : hitTP

    if exitBySL or exitByTP
        float exitPrice = exitByTP ? btTP : btSL

        float pnlPct = btSide == 1 ? (exitPrice - btEntry) / btEntry * 100.0 : (btEntry - exitPrice) / btEntry * 100.0

        shouldCount = not countOnlyEntry2Hit or btEntry2Hit

        if shouldCount
            btClosed += 1
            btSumPnL += pnlPct
            btTotalPnL += pnlPct

            if pnlPct > 0
                btWins += 1
            else
                btLosses += 1

        // reset trade state
        btInTrade := false
        btSide := 0
        btEntry := na
        btTP := na
        btSL := na

// ---- Metrics ----
winrate = btClosed > 0 ? (btWins * 100.0 / btClosed) : na
avgPnL  = btClosed > 0 ? (btSumPnL / btClosed) : na

// ---- Table UI ----
f_getPos(_p) =>
   _p == "Top Right" ? position.top_right : _p == "Right Center" ? position.middle_right : position.top_center

var table bt = na
if btEnabled and na(bt)
    bt := table.new(f_getPos(btPos), 2, 9, frame_width=1)

bg = btFillBg ? color.new(color.rgb(27,31,43), 0) : na
fg = color.white

// Draw
if btEnabled and not na(bt)
    table.cell(bt, 0, 0, "TLS1 Backtesting", text_color=fg, bgcolor=bg, text_halign=text.align_center)
    table.cell(bt, 1, 0, "", text_color=fg, bgcolor=bg)

    table.cell(bt, 0, 1, "Total Entries", text_color=fg, bgcolor=bg)
    table.cell(bt, 1, 1, str.tostring(btEntries), text_color=fg, bgcolor=bg)

    table.cell(bt, 0, 2, "Wins", text_color=fg, bgcolor=bg)
    table.cell(bt, 1, 2, str.tostring(btWins), text_color=fg, bgcolor=bg)

    table.cell(bt, 0, 3, "Losses", text_color=fg, bgcolor=bg)
    table.cell(bt, 1, 3, str.tostring(btLosses), text_color=fg, bgcolor=bg)

    table.cell(bt, 0, 4, "Winrate", text_color=fg, bgcolor=bg)
    table.cell(bt, 1, 4, btClosed > 0 ? (str.tostring(winrate, "#.##") + "%") : "—", text_color=fg, bgcolor=bg)

    table.cell(bt, 0, 5, "Average Profit", text_color=fg, bgcolor=bg)
    table.cell(bt, 1, 5, btClosed > 0 ? (str.tostring(avgPnL, "#.##") + "%") : "—", text_color=fg, bgcolor=bg)

    table.cell(bt, 0, 6, "Total Profit", text_color=fg, bgcolor=bg)
    table.cell(bt, 1, 6, btClosed > 0 ? (str.tostring(btTotalPnL, "#.##") + "%") : "—", text_color=fg, bgcolor=bg)

    table.cell(bt, 0, 7, "In Trade", text_color=fg, bgcolor=bg)
    table.cell(bt, 1, 7, btInTrade ? "YES" : "NO", text_color=fg, bgcolor=bg)

    table.cell(bt, 0, 8, "TP / SL", text_color=fg, bgcolor=bg)
    table.cell(bt, 1, 8, str.tostring(btTP) + " / " + str.tostring(btSL), text_color=fg, bgcolor=bg)

//=============================
// ENTER SNAPSHOT FOR ALERT (independent from backtest)
//=============================
longEnterA  = longEntryTouch and (not trLive)
shortEnterA = shortEntryTouch and (not trLive)

if longEnterA or shortEnterA
    entered := true          // ✅ khóa setup lại, tránh “vào lại” cùng setup
    tradeId += 1
    trLive := true
    trEntryBar := bar_index
    trSide := longEnterA ? 1 : -1
    trEntry := setupEntry
    trEntry2 := setupEntry2
    trTP1 := setupTP1
    trTP := setupTP
    trSL := setupSL

    sentEntry := false
    sentEntry2 := false
    sentTP1 := false
    sentTP := false
    sentSL := false

//=============================
// ALERT TRIGGERS (per trade)
//=============================

// Entry trigger (khi vừa vào lệnh)
entryTick = (longEnterA or shortEnterA)

afterEntryBar = trLive and not na(trEntryBar) and bar_index > trEntryBar
// Entry2 touch: (Entry2 của bạn = fibEntry2Ratio; bạn nói tương ứng 2/3SL trong CRT)
entry2Touch = afterEntryBar and not sentEntry2 and not na(trEntry2) and (
    (trSide == 1 and low <= trEntry2) or
    (trSide == -1 and high >= trEntry2)
)

tp1Touch = afterEntryBar and not sentTP1 and not na(trTP1) and (
    (trSide == 1 and high >= trTP1) or
    (trSide == -1 and low  <= trTP1)
)

tpTouch = afterEntryBar and not sentTP and not na(trTP) and (
    (trSide == 1 and high >= trTP) or
    (trSide == -1 and low  <= trTP)
)

slTouch = afterEntryBar and not sentSL and not na(trSL) and (
    (trSide == 1 and low  <= trSL) or
    (trSide == -1 and high >= trSL)
)

// Nếu cùng nến chạm TP & SL -> ưu tiên giống setting backtest (btConservative)
tpSameBar = tpTouch and slTouch
doSL = tpSameBar ? btConservative : slTouch
doTP = tpSameBar ? (not btConservative) : tpTouch

//=============================
// SEND ALERTS (alertcondition + webhook alert())
//=============================
sideTxt = trSide == 1 ? "Long" : "Short"

// 1) ENTRY
if entryTick and trLive
    if (trSide == 1 and buyAlertEnabled) or (trSide == -1 and sellAlertEnabled)
        // webhook
        if useWebhookAlert
            alert(buildPayload("ENTRY", sideTxt, trEntry, trEntry2, trSL, trTP1, trTP, tradeId), alert.freq_once_per_bar_close)
    sentEntry := true

// 2) ENTRY2
if entry2Touch and entry2AlertEnabled
    if useWebhookAlert
        alert(buildPayload("ENTRY2", sideTxt, trEntry, trEntry2, trSL, trTP1, trTP, tradeId), alert.freq_once_per_bar_close)
    sentEntry2 := true

// 3) TP1 (2/3TP)
if tp1Touch and tp1AlertEnabled
    if useWebhookAlert
        alert(buildPayload("TP1", sideTxt, trEntry, trEntry2, trSL, trTP1, trTP, tradeId), alert.freq_once_per_bar_close)
    sentTP1 := true

// 4) SL (ưu tiên nếu cùng nến)
if doSL and slAlertEnabled
    if useWebhookAlert
        alert(buildPayload("SL", sideTxt, trEntry, trEntry2, trSL, trTP1, trTP, tradeId), alert.freq_once_per_bar_close)
    sentSL := true
    // trade ended
    trLive := false
    trEntryBar := na
    // after trLive := false
    setupActive := false
    entered := true

// 5) TP
if doTP and tpAlertEnabled
    if useWebhookAlert
        alert(buildPayload("TP", sideTxt, trEntry, trEntry2, trSL, trTP1, trTP, tradeId), alert.freq_once_per_bar_close)
    sentTP := true
    // trade ended
    trLive := false
    trEntryBar := na
    // after trLive := false
    setupActive := false
    entered := true

// TEST button
if testAlert and useWebhookAlert
    alert(buildPayload("TEST", "NA", close, close, close, close, close, tradeId), alert.freq_once_per_bar_close)

alertcondition(longEnterA,  "Long Entry",  "LONG Entry")
alertcondition(shortEnterA, "Short Entry", "SHORT Entry")
alertcondition(entry2Touch, "Entry2 Touch", "Entry2 touched")
alertcondition(tp1Touch,    "TP 2/3 Touch", "TP1 (2/3TP) touched")
alertcondition(tpTouch,     "Full TP",      "Full TP touched")
alertcondition(slTouch,     "Stop Loss",    "SL touched")
//~~ }















